# Set the secrets in .env.local (gitignored) or the process environment.
# 1Password users can reference items instead, e.g. JMAP_BEARER_TOKEN=op(op://Vault/Item/credential).
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @defaultSensitive=false
# ---

# JMAP session endpoint (Fastmail by default).
# @type=url @required
JMAP_SESSION_URL=https://api.fastmail.com/jmap/session

# JMAP API token (Fastmail: Mail scope, read/write).
# @type=string @sensitive @required
JMAP_BEARER_TOKEN=

# TypeSafe API key used for Jev classification.
# @type=string @sensitive @required
TYPESAFE_API_KEY=
